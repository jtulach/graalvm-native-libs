<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.apidesign.bench</groupId>
        <artifactId>bench</artifactId>
        <version>2.0-SNAPSHOT</version>
    </parent>
    <artifactId>bench-channel</artifactId>
    <packaging>jar</packaging>

    <name>Benchmark: Channel Between JVMs</name>

    <properties>
        <moduleName>org.apidesign.bench.channel</moduleName>
        <exec.mainClass>${moduleName}.ChannelBenchmarkMain</exec.mainClass>
        <repoDir>../..</repoDir>
        <skipTests>true</skipTests>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.apidesign.graalvm</groupId>
            <artifactId>jvm-channel</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${exec.mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>bench-channel</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>transitive-classes</id>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- Not JMH - overrides bench/pom.xml's default exec:exec arguments with this
                 module's own hand-rolled main class. Mode "mock" is the safe, fast, no-setup
                 default for `mvn exec:exec`; modes "native"/"hotspot" need explicit args. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <arguments combine.self="override">
                        <argument>-cp</argument>
                        <classpath/>
                        <argument>${exec.mainClass}</argument>
                        <argument>--mode=mock</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>native</id>
            <properties>
                <skipTests>false</skipTests>
                <skipNativeTests>true</skipNativeTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>${exec.mainClass}</mainClass>
                                <buildArgs>
                                    <arg>-Ob</arg>
                                    <arg>-ea</arg>
                                    <arg>-H:+UnlockExperimentalVMOptions</arg>
                                    <arg>-H:+JDWP</arg>
                                </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
